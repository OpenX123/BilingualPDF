msgid "> [!NOTE]\n> welcome page will work if only authentication file is not blank.\n> If authentication file is blank, there will be no authentication. :)\n"
msgstr "> [!NOTE]\n> Приветственная страница будет работать, только если файл аутентификации не пуст.\n> Если файл аутентификации пуст, аутентификация не будет выполняться. :)\n"

# This content is from "advanced.md", line 417
msgctxt "chunk_4A9C44BF"
msgid "#### Glossary Support\n"
msgstr "#### Поддержка глоссария\n"

